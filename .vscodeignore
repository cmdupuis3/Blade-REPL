# Packaging exclusions for `vsce package`. Without this, vendor/ (~200 MB of
# downloaded GR binaries) would land in the .vsix. media/ is deliberately NOT
# excluded: the webview loads plotly.min.js from there at runtime, offline.
vendor/**
graft/**
docs/**
scripts/**
# Emitted C++ from `Blade.exe test` runs — regenerated build junk, ~4.5 MB
# across ~74 files. Untracked, so it is invisible to `git status --porcelain`
# checks but very much visible to vsce, which packages the working tree.
generated_cpp_tests/**
.ignore
*.vsix
