# graft's local graph cache — regenerable, not committed (run `graft build`).
graft/

# Regenerated by `npm install` from the committed vendor/ tarball +
# package-lock.json — not itself committed (it's not vscodeignored, so it
# still ships inside the packaged .vsix; see vendor:protocol in README.md).
node_modules/

# Downloaded upstream graphics packages (~200 MB: the GR tarball and its
# extraction). Re-fetchable from the URLs in docs/plotting-and-units-plan.md.
# Note media/plotly.min.js is NOT here — that one ships inside the extension.
# `vendor/*` (not `vendor/`) so the directory itself isn't pruned wholesale —
# excluding the directory itself defeats a later negation of one file inside
# it (git never descends to check it).
vendor/*
# ...except the vendored @blade-lang/ide-protocol tarball itself (npm pack
# output of ../Blade/protocol, refreshed by `npm run vendor:protocol`) — that
# one IS committed, since it's this extension's only runtime dependency and
# there is no npm registry involved.
!vendor/blade-lang-ide-protocol-*.tgz

# Built extension bundles from `vsce package` — reproducible from the tree.
*.vsix
